# // CAMBIAR AQUI LA RUTA BASE DEL PORTAL SI EL PROYECTO USA OTRA SUBRUTA
PORT=3003
BASE_PATH=/NOMBRE_PROYECTO

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nombre_base_datos
DOCUMENT_DB_NAME=nombre_base_documental
PROVIDER_DB_NAME=nombre_base_proveedores
HR_DB_NAME=nombre_base_recursos_humanos
RISK_DB_NAME=nombre_base_riesgo

# Autenticacion heredada. La clave se envia solo desde el API al proveedor HTTPS.
AUTH_HASH_URL=https://host/api/rest/general/GenerateMD5
AUTH_HASH_TIMEOUT_MS=5000
RECOVERY_EMAIL_DOMAIN=farmavalue.com
SESSION_SECRET=
SESSION_TTL_SECONDS=28800

# API reutilizable TD. No contiene credenciales ni requiere JWT para S3/SMTP.
TD_API_BASE_URL=https://apps.3c.group/td/api/v1
TD_API_TIMEOUT_MS=30000

# Guard obligatorio para cualquier envío o transición real.
NOTIFICATION_LIVE_ENABLED=false
NOTIFICATION_RUN_TOKEN=
NOTIFICATION_ADMIN_POSITION_CODES=7,15,32

# Destinatarios legacy opcionales. Separar varios correos con coma y completar
# únicamente en el .env local o en el gestor de secretos del despliegue.
DIGITAL_TRANSFORMATION_EMAIL=
HR_NOTIFICATION_CC=
INCIDENT_NOTIFICATION_CC=
INCIDENT_REGULATORY_CC=
INCIDENT_LEGAL_NOTIFICATION_TO=
LABOR_ACTION_NOTIFICATION_CC=
DOCUMENT_EXPIRATION_CC=
LEGAL_NOTIFICATION_EMAIL=
LEGAL_NOTIFICATION_CC=
AGREEMENT_NOTIFICATION_TO=
AGREEMENT_NOTIFICATION_BCC=
