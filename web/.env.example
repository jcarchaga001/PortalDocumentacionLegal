# // CAMBIAR AQUI LA RUTA BASE DEL PORTAL SI EL PROYECTO USA OTRA SUBRUTA
PORT=3002
VITE_BASE_PATH=/NOMBRE_PROYECTO
VITE_API_BASE_URL=/NOMBRE_PROYECTO/api
# Destino del ClientLogout legacy después de cerrar la sesión local.
VITE_POST_LOGOUT_URL=https://fep-dev.outsystemsenterprise.com/IndicedeAplicaciones/scrInicio

# Destino privado opcional para desarrollo local o proxy desde el servidor web.
# No se configura en PM2 y no altera la ruta publica del portal.
API_PROXY_TARGET=http://127.0.0.1:3003

# Secreto solo del proxy web (sin prefijo VITE_). Debe coincidir con el API
# para habilitar el botón protegido Enviar Correo; nunca se incluye en el bundle.
NOTIFICATION_RUN_TOKEN=
